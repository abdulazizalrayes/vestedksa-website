{
  "name": "vestedksa-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "generate:markdown": "node scripts/generate-markdown-companions.mjs",
    "check:markdown": "node scripts/generate-markdown-companions.mjs --check",
    "indexnow:dry-run": "node scripts/submit-indexnow.mjs --dry-run",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "validate:markdown-layer": "node scripts/validate-markdown-layer.mjs",
    "validate:agent-readiness": "node scripts/validate-agent-readiness.js",
    "validate:site-integrity": "node scripts/validate-site-integrity.mjs",
    "validate:deployment-output": "node scripts/validate-deployment-output.mjs",
    "validate:live": "node scripts/validate-live-agent-surface.mjs",
    "report:agent-funnel": "node scripts/report-agent-funnel.mjs",
    "report:demand-learning": "node scripts/report-demand-learning.mjs",
    "validate:demand-learning": "node --test test/demand-*.test.mjs",
    "validate:release": "npm test && npm run validate:site-integrity && npm run validate:agent-readiness && npm run validate:markdown-layer"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.6"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.11.1",
    "parse5": "^8.0.1"
  }
}
