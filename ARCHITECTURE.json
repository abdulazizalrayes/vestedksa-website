      "remote": "https://github.com/abdulazizalrayes/vestedksa-website.git",
      "branch": "main"
    },
    "packageScripts": {
      "generate:markdown": "Generate deterministic Markdown companions",
      "test": "Run Accept negotiation, route resolution, Markdown API header, HEAD, and method unit tests",
      "check:markdown": "Fail when generated Markdown artifacts are stale",
      "indexnow:dry-run": "Preview the IndexNow submission payload",
      "indexnow:submit": "Submit sitemap URLs to IndexNow",
      "validate:markdown-layer": "Validate coverage, headers, routing, content exclusions, and optional HTML hashes",
      "validate:agent-readiness": "Validate discovery, JSON, OpenAPI, MCP runtime safety, robots, and Vercel config",
      "validate:deployment-output": "Validate Vercel build inventory and reject duplicate/private/internal artifacts",
      "validate:live": "Validate production HTML, Markdown negotiation, sidecars, discovery, MCP, and duplicate paths"
    },
    "releaseSequence": [
      "npm test",
      "npm run check:markdown",
      "npm run validate:markdown-layer",
      "npm run validate:agent-readiness",
      "npm audit --omit=dev",
      "vercel build --prod",
      "npm run validate:deployment-output",
      "Commit and push the exact source state",
      "vercel deploy --prebuilt --prod",
      "npm run validate:live",
      "npm run indexnow:submit",
      "Record evidence in VES-406"
    ],
    "deploymentIgnore": [
      "previews/",
      "CLAUDE.md",
      "README.md",
      "ARCHITECTURE.html",
      "ARCHITECTURE.json",
      "scripts/",
      "node_modules/",
      "Finder-style numbered duplicate files"
    ]
  },
  "components": [
    {
      "id": "human-browser",
      "layer": "clients",
      "name": "Human browser",
      "kind": "client",
      "description": "Ordinary visitors request static HTML, assets, forms, and downloads."
    },
    {
      "id": "search-crawlers",
      "layer": "clients",
      "name": "Search crawlers",
      "kind": "crawler",
      "description": "Google, Bing, and other permitted crawlers consume HTML, robots, sitemap, and structured data."
    },
    {
      "id": "ai-agents",
      "layer": "clients",
      "name": "AI and procurement agents",
      "kind": "agent",
      "description": "Agents consume llms files, Markdown, JSON, OpenAPI, and the read-only MCP endpoint."
    },
    {
      "id": "vercel-dns",
      "layer": "edge",
      "name": "Vercel DNS",
      "kind": "infrastructure",
      "description": "Apex and www resolve through Vercel-managed DNS."
    },
    {
      "id": "vercel-edge",
      "layer": "edge",
      "name": "Vercel edge",
      "kind": "infrastructure",
      "description": "Applies redirects, rewrites, security headers, caching, and dispatch."
    },
    {
      "id": "accept-middleware",
      "layer": "edge",
      "name": "Accept negotiation",
      "kind": "middleware",
      "description": "Selects HTML or Markdown by effective quality and specificity, defaults ties and ambiguity to HTML, and advertises the clean page-specific Markdown alternate."
    },
    {
      "id": "static-site",
      "layer": "application",
      "name": "Static multipage site",
      "kind": "frontend",
      "description": "Twenty canonical HTML pages, three languages, eight guides, and six public downloads."
    },
    {
      "id": "contact-form",
      "layer": "application",
      "name": "Contact form",
      "kind": "frontend",
      "description": "Collects market-entry inquiry fields and posts to /api/contact."
    },
    {
      "id": "contact-api",
      "layer": "application",
      "name": "Contact API",
      "kind": "serverless-function",
      "description": "Validates, rate-limits, sanitizes, and delivers approved inquiries over SMTP."
    },
    {
      "id": "markdown-api",
      "layer": "application",
      "name": "Markdown API",
      "kind": "serverless-function",
      "description": "Returns allowlisted Markdown content with canonical, language, clean location, Vary, Content-Signal, and direct noindex headers."
    },
    {
      "id": "mcp-api",
      "layer": "application",
      "name": "Read-only MCP",
      "kind": "serverless-function",
      "description": "Exposes eleven typed tools and fifteen public resources without external submission."
    },
    {
      "id": "html-jsonld",
      "layer": "content",
      "name": "HTML and JSON-LD",
      "kind": "content",
      "description": "Canonical public content with page-appropriate structured data."
    },
    {
      "id": "structured-data",
      "layer": "content",
      "name": "15 public JSON resources",
      "kind": "data",
      "description": "Company, services, capabilities, routing, AEO/GEO, analytics, versioning, and procurement contracts."
    },
    {
      "id": "markdown-companions",
      "layer": "content",
      "name": "20 Markdown companions",
      "kind": "content",
      "description": "Deterministic main-content representations generated from canonical HTML."
    },
    {
      "id": "routing-contracts",
      "layer": "content",
      "name": "Routing and inquiry contracts",
      "kind": "data",
      "description": "Fit routing, procurement routing, and inquiry schema enforce agent boundaries."
    },
    {
      "id": "sitemap-robots",
      "layer": "discovery",
      "name": "Sitemap and robots",
      "kind": "discovery",
      "description": "Forty-six public sitemap URLs and explicit crawler/private-path policy."
    },
    {
      "id": "llms-discovery",
      "layer": "discovery",
      "name": "LLM discovery",
      "kind": "discovery",
      "description": "llms.txt and llms-full orient assistants to canonical pages and structured resources."
    },
    {
      "id": "agent-discovery",
      "layer": "discovery",
      "name": "Agent and API discovery",
      "kind": "discovery",
      "description": "Agent card, API catalog, MCP cards, skills, OpenAPI, and auth guidance."
    },
    {
      "id": "markdown-manifest",
      "layer": "discovery",
      "name": "Markdown manifest",
      "kind": "discovery",
      "description": "Maps every canonical HTML route to its clean direct Markdown URL and legacy language-specific sidecar."
    },
    {
      "id": "smtp-service",
      "layer": "external",
      "name": "Private-email SMTP",
      "kind": "external-service",
      "description": "Receives validated contact inquiry email over TLS."
    },
    {
      "id": "ga4-gtm",
      "layer": "external",
      "name": "GA4 and GTM",
      "kind": "external-service",
      "description": "Receives privacy-safe page, intent, language, download, and conversion events."
    },
    {
      "id": "google-search",
      "layer": "external",
      "name": "Google Search Console",
      "kind": "external-service",
      "description": "Sitemap, indexing, search performance, and rich-result operations."
    },
    {
      "id": "bing-indexnow",
      "layer": "external",
      "name": "Bing and IndexNow",
      "kind": "external-service",
      "description": "Sitemap operations and explicit URL-change notifications."
    },
    {
      "id": "github",
      "layer": "operations",
      "name": "GitHub source",
      "kind": "operations",
      "description": "Repository, branch, commit history, and rollback source."
    },
    {
      "id": "validation-suite",
      "layer": "operations",
      "name": "Validation suite",
      "kind": "operations",
      "description": "Determinism, schema, MCP, SEO, build inventory, live endpoint, and dependency checks."
    },
    {
      "id": "vercel-deploy",
      "layer": "operations",
      "name": "Vercel deployment",
      "kind": "operations",
      "description": "Builds and publishes the exact validated artifact to production."
    },
    {
      "id": "paperclip-record",
      "layer": "operations",
      "name": "Paperclip VES-406",
      "kind": "operations",
      "description": "Stores identity lock, evidence, cost, deployment, verification, and rollback."
    }
  ],
  "flows": [
    {
      "id": "html-page-request",
      "name": "Ordinary HTML page request",
      "trigger": "Browser sends a normal GET or Accept: text/html",
      "steps": [
        {
          "from": "human-browser",
          "to": "vercel-dns",
          "action": "Resolve vestedksa.com"
        },
        {
          "from": "vercel-dns",
          "to": "vercel-edge",
          "action": "Route request to Vercel"
        },
        {
          "from": "vercel-edge",
          "to": "accept-middleware",
          "action": "Evaluate canonical route and Accept header"
        },
        {
          "from": "accept-middleware",
          "to": "static-site",
          "action": "Continue without rewrite"
        },
        {
          "from": "static-site",
          "to": "human-browser",
          "action": "Return static HTML and assets"
        }
      ],
      "invariants": [
        "Ordinary requests remain HTML",
        "Canonical URL and hreflang remain unchanged"
      ]
    },
    {
      "id": "markdown-negotiation",
      "name": "Canonical URL to Markdown",
      "trigger": "Agent prefers Markdown after q-value and specificity evaluation, with HTML winning an equal explicit preference",
      "steps": [
        {
          "from": "ai-agents",
          "to": "vercel-edge",
          "action": "Request canonical page"
        },
        {
          "from": "vercel-edge",
          "to": "accept-middleware",
          "action": "Parse Accept header"
        },
        {
          "from": "accept-middleware",
          "to": "markdown-api",
          "action": "Rewrite allowlisted route to /api/markdown"
        },
        {
          "from": "markdown-companions",
          "to": "markdown-api",
          "action": "Read explicit generated asset"
        },
        {
          "from": "markdown-api",
          "to": "ai-agents",
          "action": "Return Markdown with language, canonical, location, Vary, and Content-Signal headers"
        }
      ],
      "invariants": [
        "A q=0 representation is never selected",
        "Equal explicit HTML and Markdown preference defaults to HTML",
        "Missing or ambiguous Accept defaults to HTML",
        "Missing companions fall back safely",
        "Clean and legacy direct companions remain noindex, follow",
        "Canonical HTML and HEAD responses advertise the page-specific clean .md alternate"
      ]
    },
    {
      "id": "search-discovery",
      "name": "Search crawler discovery",
      "trigger": "Crawler visits the domain",
      "steps": [
        {
          "from": "search-crawlers",
          "to": "sitemap-robots",
          "action": "Read permissions and URL inventory"
        },
        {
          "from": "sitemap-robots",
          "to": "static-site",
          "action": "Discover canonical public pages"
        },
        {
          "from": "static-site",
          "to": "html-jsonld",
          "action": "Expose canonical content and structured data"
        },
        {
          "from": "html-jsonld",
          "to": "google-search",
          "action": "Index and evaluate rich results"
        },
        {
          "from": "sitemap-robots",
          "to": "bing-indexnow",
          "action": "Submit sitemap and URL changes"
        }
      ]
    },
    {
      "id": "agent-discovery-and-read",
      "name": "Agent discovery and public read",
      "trigger": "Assistant or procurement agent needs Vested facts",
      "steps": [
        {
          "from": "ai-agents",
          "to": "llms-discovery",
          "action": "Read orientation and safety rules"
        },
        {
          "from": "llms-discovery",
          "to": "agent-discovery",
          "action": "Locate OpenAPI, MCP, skills, and API catalog"
        },
        {
          "from": "agent-discovery",
          "to": "structured-data",
          "action": "Read canonical JSON resources"
        },
        {
          "from": "structured-data",
          "to": "ai-agents",
          "action": "Return citation-ready public facts"
        }
      ]
    },
    {
      "id": "mcp-read-only",
      "name": "Read-only MCP call",
      "trigger": "MCP client initializes and calls a public tool",
      "steps": [
        {
          "from": "ai-agents",
          "to": "agent-discovery",
          "action": "Discover protocol and endpoint"
        },
        {
          "from": "agent-discovery",
          "to": "mcp-api",
          "action": "Initialize MCP 2025-11-25"
        },
        {
          "from": "structured-data",
          "to": "mcp-api",
          "action": "Read explicit bundled resources"
        },
        {
          "from": "routing-contracts",
          "to": "mcp-api",
          "action": "Apply fit, procurement, and approval rules"
        },
        {
          "from": "mcp-api",
          "to": "ai-agents",
          "action": "Return JSON-RPC result without submission"
        }
      ],
      "invariants": [
        "No form submission",
        "No email",
        "No personal-data storage",
        "Inquiry preparation remains not_submitted"
      ]
    },
    {
      "id": "approved-contact-inquiry",
      "name": "Approved contact inquiry",
      "trigger": "Human explicitly submits the contact form",
      "steps": [
        {
          "from": "human-browser",
          "to": "contact-form",
          "action": "Complete required market-entry fields"
        },
        {
          "from": "contact-form",
          "to": "contact-api",
          "action": "POST sanitized JSON"
        },
        {
          "from": "routing-contracts",
          "to": "contact-api",
          "action": "Contract defines required inquiry data and approval boundary"
        },
        {
          "from": "contact-api",
          "to": "smtp-service",
          "action": "Deliver validated inquiry over TLS"
        },
        {
          "from": "contact-api",
          "to": "contact-form",
          "action": "Return success or safe error"
        },
        {
          "from": "contact-form",
          "to": "ga4-gtm",
          "action": "Record privacy-safe conversion event after success"
        }
      ],
      "invariants": [
        "Agents require explicit user approval before submission",
        "Analytics excludes personal fields and message body"
      ]
    },
    {
      "id": "analytics-event",
      "name": "Privacy-safe analytics",
      "trigger": "Visitor views, clicks, switches language, downloads, or completes a form",
      "steps": [
        {
          "from": "static-site",
          "to": "ga4-gtm",
          "action": "Send approved client event taxonomy"
        },
        {
          "from": "mcp-api",
          "to": "vercel-deploy",
          "action": "Write broad, privacy-safe runtime log event"
        }
      ]
    },
    {
      "id": "release-pipeline",
      "name": "Validated production release",
      "trigger": "Source or public contract changes",
      "steps": [
        {
          "from": "github",
          "to": "validation-suite",
          "action": "Check deterministic content, schemas, MCP, SEO, security, and dependencies"
        },
        {
          "from": "validation-suite",
          "to": "vercel-deploy",
          "action": "Build exact production artifact and reject duplicate/private files"
        },
        {
          "from": "vercel-deploy",
          "to": "vercel-edge",
          "action": "Publish and alias production"
        },
        {
          "from": "vercel-edge",
          "to": "validation-suite",
          "action": "Run live coverage and behavior checks"
        },
        {
          "from": "validation-suite",
          "to": "paperclip-record",
          "action": "Record evidence, cost, and rollback"
        }
      ]
    }
  ],
  "dataContracts": [
    {
      "id": "canonical-html",
      "producer": "Hand-maintained static HTML pages",
      "consumers": [
        "Human browsers",
        "Search crawlers",
        "Markdown generator"
      ],
      "contract": "Canonical, indexable HTML with robots metadata, JSON-LD, and stable clean URLs"
    },
    {
      "id": "markdown-manifest",
      "producer": "scripts/generate-markdown-companions.mjs",
      "consumers": [
        "middleware.ts",
        "api/markdown.js",
        "Agents",
        "Validation scripts"
      ],
      "contract": "One entry per canonical indexable HTML sitemap page"
    },
    {
      "id": "public-json",
      "producer": "Vested-maintained data/*.json files",
      "consumers": [
        "MCP tools",
        "OpenAPI clients",
        "Search and AI agents",
        "llms discovery"
      ],
      "contract": "Public, verified, privacy-safe, additive versioned facts only"
    },
    {
      "id": "contact-request",
      "producer": "contact.html",
      "consumers": [
        "api/contact.js"
      ],
      "contract": "Required name, email, company, country, service, and message; honeypot must remain empty"
    },
    {
      "id": "mcp-json-rpc",
      "producer": "api/mcp.js",
      "consumers": [
        "MCP-capable agents"
      ],
      "contract": "JSON-RPC 2.0, MCP 2025-11-25 current, read-only resources and tools"
    },
    {
      "id": "analytics-taxonomy",
      "producer": "data/analytics-events.json",
      "consumers": [
        "Page scripts",
        "GA4",
        "GTM",
        "Monthly reporting"
      ],
      "contract": "No personal information or full inquiry content in events"
    }
  ],
  "invariants": [
    {
      "id": "identity-isolation",
      "severity": "critical",
      "rule": "Never mix Vested assets, accounts, facts, credentials, analytics, deployments, or Paperclip records with another company."
    },
    {
      "id": "visual-freeze",
      "severity": "high",
      "rule": "Do not change public visual HTML without owner approval."
    },
    {
      "id": "html-default",
      "severity": "critical",
      "rule": "Canonical URLs return HTML unless text/markdown is explicitly accepted with q greater than zero."
    },
    {
      "id": "markdown-noindex",
      "severity": "high",
      "rule": "Direct Markdown sidecars return X-Robots-Tag: noindex, follow."
    },
    {
      "id": "content-signal",
      "severity": "high",
      "rule": "Public content policy remains ai-train=no, search=yes, ai-input=yes unless the owner changes it."
    },
    {
      "id": "agent-read-only",
      "severity": "critical",
      "rule": "MCP does not submit forms, send email, or contact Vested KSA."
    },
    {
      "id": "contact-approval",
      "severity": "critical",
      "rule": "An agent may use /api/contact only after explicit user approval of final content and destination."
    },
    {
      "id": "verified-facts-only",
      "severity": "high",
      "rule": "Do not invent legal numbers, coordinates, certifications, social links, clients, testimonials, or case studies."
    },
    {
      "id": "privacy",
      "severity": "critical",
      "rule": "Do not expose secrets or log personal and confidential inquiry data."
    },
    {
      "id": "deployment-integrity",
      "severity": "high",
      "rule": "Do not deploy if required validation fails or numbered duplicate files enter the build."
    }
  ],
  "changeGuide": [
    {
      "change": "Add or edit a canonical page",
      "touch": [
        "Relevant .html file",
        "sitemap.xml",
        "Relevant JSON-LD",
        "Potential llms/source-map/answer-engine entries"
      ],
      "thenRun": [
        "npm run generate:markdown",
        "npm run validate:markdown-layer",
        "npm run validate:agent-readiness",
        "vercel build --prod",
        "npm run validate:deployment-output",
        "npm run validate:live"
      ]
    },
    {
      "change": "Add or edit a service",
      "touch": [
        "data/services.json",
        "data/capabilities.json when applicable",
        "services.html",
        "service-pages.json",
        "openapi.json when the contract changes",
        "data/schema-versions.json and data/changelog.json"
      ],
      "thenRun": [
        "npm run generate:markdown",
        "npm run validate:agent-readiness",
        "npm run validate:markdown-layer"
      ]
    },
    {
      "change": "Change inquiry fields or routing",
      "touch": [
        "data/project-inquiry-schema.json",
        "data/agent-routing.json",
        "data/procurement-routing.json",
        "api/mcp.js",
        "contact.html and api/contact.js only when submission fields change",
        "openapi.json"
      ],
      "thenRun": [
        "npm run validate:agent-readiness",
        "npm run validate:live"
      ]
    },
    {
      "change": "Change Markdown behavior",
      "touch": [
        "scripts/generate-markdown-companions.mjs",
        "middleware.ts",
        "lib/markdown-negotiation.mjs",
        "api/markdown.js",
        "vercel.json"
      ],
      "thenRun": [
        "npm run generate:markdown",
        "npm run check:markdown",
        "npm run validate:markdown-layer",
        "vercel build --prod",
        "npm run validate:deployment-output",
        "npm run validate:live"
      ]
    },
    {
      "change": "Change MCP tools or resources",
      "touch": [
        "api/mcp.js",
        ".well-known/mcp.json",
        ".well-known/mcp/server-card.json",
        ".well-known/agent-card.json",
        "openapi.json",
        "llms.txt",
        "data/agent-manifest.json",
        "data/schema-versions.json and data/changelog.json"
      ],
      "thenRun": [
        "npm run validate:agent-readiness",
        "npm run validate:live"
      ]
    },
    {
      "change": "Change analytics events",
      "touch": [
        "data/analytics-events.json",
        "language-switcher.js or relevant page scripts",
        "analytics-reporting.md",
        "docs/advanced-analytics-playbook.md"
      ],
      "thenRun": [
        "Confirm no personal fields are transmitted",
        "npm run validate:agent-readiness"
      ]
    },
    {
      "change": "Release to production",
      "touch": [
        "Only the intended Vested files"
      ],
      "thenRun": [
        "Complete every buildAndRelease.releaseSequence step",
        "Record deployment, commit, cost, evidence, and rollback in VES-406"
      ]
    }
  ],
  "knownConstraints": [
    "The site intentionally has no public CLI or npm package because current workflows are repository-local and HTTP-based.",
    "The contact rate limit is per warm serverless instance and is not a globally consistent distributed limit.",
    "Static llms, OpenAPI, and data-file reads are observed through hosting/access analytics rather than a dedicated event sink.",
    "CR, VAT, license numbers, client logos, testimonials, case studies, certifications, exact coordinates, and Wikidata are intentionally not asserted.",
    "Repository-local architecture files are intentionally excluded from the public Vercel deployment."
  ],
  "freshness": {
    "lastAudited": "2026-07-26",
    "updateThisMapWhen": [
      "A canonical route is added, removed, or renamed",
      "A data contract or MCP tool changes",
      "Hosting, DNS, repository, analytics, SMTP, or Paperclip ownership changes",
      "A new external service or secret class is introduced",
      "The release pipeline or validation commands change",
      "A visual feature materially changes page behavior",
      "A release changes the production commit or deployment ID"
    ],
    "verificationCommands": [
      "node -e \"JSON.parse(require('fs').readFileSync('ARCHITECTURE.json','utf8')); console.log('ARCHITECTURE.json valid')\"",
      "npm run check:markdown",
      "npm run validate:markdown-layer",
      "npm run validate:agent-readiness",
      "vercel build --prod",
      "npm run validate:deployment-output",
      "npm run validate:live"
    ]
  }
}
