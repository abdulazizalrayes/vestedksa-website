{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "language-switcher.js",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.{txt,xml,json,md}",
      "use": "@vercel/static"
    },
    {
      "src": "**/*.{png,jpg,jpeg,gif,svg,ico,webp,woff,woff2}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/contact",
      "dest": "/api/contact.js"
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/ar/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/ar"
      }
    },
    {
      "src": "/zh/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/zh"
      }
    },
    {
      "src": "/about\\.html",
      "status": 308,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "/services\\.html",
      "status": 308,
      "headers": {
        "Location": "/services"
      }
    },
    {
      "src": "/why-saudi\\.html",
      "status": 308,
      "headers": {
        "Location": "/why-saudi"
      }
    },
    {
      "src": "/ethics\\.html",
      "status": 308,
      "headers": {
        "Location": "/ethics"
      }
    },
    {
      "src": "/insights\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights"
      }
    },
    {
      "src": "/insights/ksa-market-entry-guide-2026\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights/ksa-market-entry-guide-2026"
      }
    },
    {
      "src": "/insights/foreign-ownership-saudi-arabia\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights/foreign-ownership-saudi-arabia"
      }
    },
    {
      "src": "/insights/misa-licensing-commercial-registration-saudi-arabia\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights/misa-licensing-commercial-registration-saudi-arabia"
      }
    },
    {
      "src": "/insights/vat-zakat-saudi-arabia\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights/vat-zakat-saudi-arabia"
      }
    },
    {
      "src": "/insights/regional-headquarters-rhq-saudi-arabia\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights/regional-headquarters-rhq-saudi-arabia"
      }
    },
    {
      "src": "/insights/saudi-vendor-registration-aramco-pif\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights/saudi-vendor-registration-aramco-pif"
      }
    },
    {
      "src": "/insights/saudization-nitaqat-hr-saudi-arabia\\.html",
      "status": 308,
      "headers": {
        "Location": "/insights/saudization-nitaqat-hr-saudi-arabia"
      }
    },
    {
      "src": "/faq\\.html",
      "status": 308,
      "headers": {
        "Location": "/faq"
      }
    },
    {
      "src": "/contact\\.html",
      "status": 308,
      "headers": {
        "Location": "/contact"
      }
    },
    {
      "src": "/privacy\\.html",
      "status": 308,
      "headers": {
        "Location": "/privacy"
      }
    },
    {
      "src": "/terms\\.html",
      "status": 308,
      "headers": {
        "Location": "/terms"
      }
    },
    {
      "src": "/blog/?",
      "status": 308,
      "headers": {
        "Location": "/insights"
      }
    },
    {
      "src": "/cookies/?",
      "status": 308,
      "headers": {
        "Location": "/privacy"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept"
      },
      "dest": "/llms-full.md"
    },
    {
      "src": "/",
      "headers": {
        "Link": "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\", </llms-full.md>; rel=\"alternate\"; type=\"text/markdown\", </service-pages.json>; rel=\"service-desc\"; type=\"application/json\", </.well-known/agent-card.json>; rel=\"agent-card\"; type=\"application/json\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\"; type=\"application/json\"",
        "Vary": "Accept"
      },
      "dest": "/index.html"
    },
    {
      "src": "/ar/?",
      "dest": "/ar/index.html"
    },
    {
      "src": "/zh/?",
      "dest": "/zh/index.html"
    },
    {
      "src": "/about/?",
      "dest": "/about.html"
    },
    {
      "src": "/services/?",
      "dest": "/services.html"
    },
    {
      "src": "/why-saudi/?",
      "dest": "/why-saudi.html"
    },
    {
      "src": "/ethics/?",
      "dest": "/ethics.html"
    },
    {
      "src": "/insights/?",
      "dest": "/insights.html"
    },
    {
      "src": "/insights/ksa-market-entry-guide-2026/?",
      "dest": "/insights/ksa-market-entry-guide-2026.html"
    },
    {
      "src": "/insights/foreign-ownership-saudi-arabia/?",
      "dest": "/insights/foreign-ownership-saudi-arabia.html"
    },
    {
      "src": "/insights/misa-licensing-commercial-registration-saudi-arabia/?",
      "dest": "/insights/misa-licensing-commercial-registration-saudi-arabia.html"
    },
    {
      "src": "/insights/vat-zakat-saudi-arabia/?",
      "dest": "/insights/vat-zakat-saudi-arabia.html"
    },
    {
      "src": "/insights/regional-headquarters-rhq-saudi-arabia/?",
      "dest": "/insights/regional-headquarters-rhq-saudi-arabia.html"
    },
    {
      "src": "/insights/saudi-vendor-registration-aramco-pif/?",
      "dest": "/insights/saudi-vendor-registration-aramco-pif.html"
    },
    {
      "src": "/insights/saudization-nitaqat-hr-saudi-arabia/?",
      "dest": "/insights/saudization-nitaqat-hr-saudi-arabia.html"
    },
    {
      "src": "/faq/?",
      "dest": "/faq.html"
    },
    {
      "src": "/contact/?",
      "dest": "/contact.html"
    },
    {
      "src": "/privacy/?",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms/?",
      "dest": "/terms.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|ico|png|jpg|jpeg|gif|svg|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|gif|svg|webp|woff|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "trailingSlash": false
}
